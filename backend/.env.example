# Server
PORT=3000
NODE_ENV=development

# Auth (AWS Cognito or custom JWT secret for local dev)
JWT_SECRET=change-me-in-production-use-secrets-manager
JWT_EXPIRY=1h
REFRESH_TOKEN_EXPIRY=30d

# AI (Claude via AWS Bedrock — not the Anthropic API directly, so PHI stays inside AWS's HIPAA BAA)
# Set USE_MOCK_CLAUDE=true to skip real calls during development (no AWS credentials needed)
USE_MOCK_CLAUDE=true
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0

# Database (RDS PostgreSQL in prod, local postgres for dev)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=discharge
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false

# CORS
ALLOWED_ORIGINS=http://localhost:8081
